{
  // O `uschema` é editable install do .venv do uv; sem fixar o interpretador o
  // VSCode pode pegar o Python do sistema e marcar todo import como não
  // resolvido (neo4j, pymongo, pyecore, uschema).
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // `src` porque o layout é src/; `scripts` porque as baterias importam os
  // módulos irmãos `output` e `baseline` sem pacote — funciona em execução
  // (o Python põe o diretório do script no sys.path), mas o Pylance analisa a
  // partir da raiz do workspace e não acharia nenhum dos dois.
  "python.analysis.extraPaths": ["src", "scripts"],
  // Pyrefly (extensão `meta.pyrefly`) desligado neste workspace: ele duplica o
  // language server do Pylance e, por inferir da fonte as libs sem `py.typed`,
  // acusava ~530 erros na fronteira do PyEcore que o `mypy` do gate não vê. A
  // checagem oficial do projeto é `uv run mypy .`, no pre-commit e no CI.
  "python.pyrefly.disableTypeErrors": true,
  "python.pyrefly.disableLanguageServices": true,
  // Pylance explícito. Com o padrão ("Default"), a extensão Python vê o Pyrefly
  // instalado e liga o servidor de idiomas em "None" — e como o Pyrefly está
  // com os serviços desligados acima, o editor fica sem autocomplete nenhum.
  "python.languageServer": "Pylance",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"]
}
